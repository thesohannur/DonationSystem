{
    "info": {
        "_postman_id": "campaigns-collection",
        "name": "DonationSystem Campaigns API",
        "description": "Campaigns API endpoints",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "Get All Campaigns",
            "request": {
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "{{baseUrl}}/api/campaigns?approved=true",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "campaigns"
                    ],
                    "query": [
                        {
                            "key": "approved",
                            "value": "true",
                            "description": "Optional filter"
                        },
                        {
                            "key": "active",
                            "value": "true",
                            "description": "Optional filter",
                            "disabled": true
                        }
                    ]
                }
            },
            "response": []
        },
        {
            "name": "Get Campaigns by NGO",
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{token}}",
                        "type": "text"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/api/campaigns/ngo/:email",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "campaigns",
                        "ngo",
                        ":email"
                    ],
                    "variable": [
                        {
                            "key": "email",
                            "value": "ngo@example.com"
                        }
                    ]
                }
            },
            "response": []
        },
        {
            "name": "Get Single Campaign",
            "request": {
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "{{baseUrl}}/api/campaigns/:id",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "campaigns",
                        ":id"
                    ],
                    "variable": [
                        {
                            "key": "id",
                            "value": ""
                        }
                    ]
                }
            },
            "response": []
        },
        {
            "name": "Create Campaign",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{ngoToken}}",
                        "type": "text"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"title\": \"Clean Water Initiative\",\n  \"description\": \"Providing clean water to remote villages.\",\n  \"image\": \"https://example.com/image.jpg\",\n  \"goalAmount\": 5000,\n  \"expirationTime\": \"2024-12-31T23:59:59.000Z\",\n  \"ngoEmail\": \"ngo@example.com\",\n  \"ngoId\": \"replace_with_ngo_id\"\n}",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
                },
                "url": {
                    "raw": "{{baseUrl}}/api/campaigns",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "campaigns"
                    ]
                }
            },
            "response": []
        },
        {
            "name": "Update Campaign",
            "request": {
                "method": "PATCH",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{ngoToken}}",
                        "type": "text"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"title\": \"Clean Water Initiative - Updated\",\n  \"goalAmount\": 6000\n}",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
                },
                "url": {
                    "raw": "{{baseUrl}}/api/campaigns/:id",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "campaigns",
                        ":id"
                    ],
                    "variable": [
                        {
                            "key": "id",
                            "value": ""
                        }
                    ]
                }
            },
            "response": []
        },
        {
            "name": "Approve Campaign",
            "request": {
                "method": "PATCH",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{adminToken}}",
                        "type": "text"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/api/campaigns/:id/approve",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "campaigns",
                        ":id",
                        "approve"
                    ],
                    "variable": [
                        {
                            "key": "id",
                            "value": ""
                        }
                    ]
                }
            },
            "response": []
        },
        {
            "name": "Reject Campaign",
            "request": {
                "method": "PATCH",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{adminToken}}",
                        "type": "text"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/api/campaigns/:id/reject",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "campaigns",
                        ":id",
                        "reject"
                    ],
                    "variable": [
                        {
                            "key": "id",
                            "value": ""
                        }
                    ]
                }
            },
            "response": []
        },
        {
            "name": "Delete Campaign",
            "request": {
                "method": "DELETE",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{ngoToken}}",
                        "type": "text"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/api/campaigns/:id",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "campaigns",
                        ":id"
                    ],
                    "variable": [
                        {
                            "key": "id",
                            "value": ""
                        }
                    ]
                }
            },
            "response": []
        }
    ],
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:5002",
            "type": "string"
        },
        {
            "key": "token",
            "value": "",
            "type": "string"
        },
        {
            "key": "adminToken",
            "value": "",
            "type": "string"
        },
        {
            "key": "ngoToken",
            "value": "",
            "type": "string"
        }
    ]
}