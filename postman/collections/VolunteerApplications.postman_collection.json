{
    "info": {
        "_postman_id": "volunteer-applications-collection",
        "name": "DonationSystem Volunteer Applications API",
        "description": "Volunteer Applications API endpoints",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "Get All Applications",
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{adminToken}}",
                        "type": "text"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/api/volunteers",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "volunteers"
                    ]
                }
            },
            "response": []
        },
        {
            "name": "Get Applications by Donor",
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{token}}",
                        "type": "text"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/api/volunteers/donor/:donorId",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "volunteers",
                        "donor",
                        ":donorId"
                    ],
                    "variable": [
                        {
                            "key": "donorId",
                            "value": ""
                        }
                    ]
                }
            },
            "response": []
        },
        {
            "name": "Get Applications by NGO",
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{token}}",
                        "type": "text"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/api/volunteers/ngo/:ngoId",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "volunteers",
                        "ngo",
                        ":ngoId"
                    ],
                    "variable": [
                        {
                            "key": "ngoId",
                            "value": ""
                        }
                    ]
                }
            },
            "response": []
        },
        {
            "name": "Get Applications by Opportunity",
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{token}}",
                        "type": "text"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/api/volunteers/opportunity/:opportunityId",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "volunteers",
                        "opportunity",
                        ":opportunityId"
                    ],
                    "variable": [
                        {
                            "key": "opportunityId",
                            "value": ""
                        }
                    ]
                }
            },
            "response": []
        },
        {
            "name": "Get Single Application",
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{token}}",
                        "type": "text"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/api/volunteers/:id",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "volunteers",
                        ":id"
                    ],
                    "variable": [
                        {
                            "key": "id",
                            "value": ""
                        }
                    ]
                }
            },
            "response": []
        },
        {
            "name": "Create Application",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{donorToken}}",
                        "type": "text"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"donorId\": \"replace_with_donor_id\",\n  \"opportunityId\": \"replace_with_opportunity_id\",\n  \"ngoId\": \"replace_with_ngo_id\",\n  \"notes\": \"I have 2 years of experience.\"\n}",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
                },
                "url": {
                    "raw": "{{baseUrl}}/api/volunteers",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "volunteers"
                    ]
                }
            },
            "response": []
        },
        {
            "name": "Update Application Status",
            "request": {
                "method": "PATCH",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{ngoToken}}",
                        "type": "text"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"status\": \"APPROVED\",\n  \"hoursCompleted\": 10\n}",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
                },
                "url": {
                    "raw": "{{baseUrl}}/api/volunteers/:id",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "volunteers",
                        ":id"
                    ],
                    "variable": [
                        {
                            "key": "id",
                            "value": ""
                        }
                    ]
                }
            },
            "response": []
        },
        {
            "name": "Delete Application",
            "request": {
                "method": "DELETE",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{token}}",
                        "type": "text"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/api/volunteers/:id",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "volunteers",
                        ":id"
                    ],
                    "variable": [
                        {
                            "key": "id",
                            "value": ""
                        }
                    ]
                }
            },
            "response": []
        }
    ],
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:5002",
            "type": "string"
        },
        {
            "key": "token",
            "value": "",
            "type": "string"
        },
        {
            "key": "adminToken",
            "value": "",
            "type": "string"
        },
        {
            "key": "ngoToken",
            "value": "",
            "type": "string"
        },
        {
            "key": "donorToken",
            "value": "",
            "type": "string"
        }
    ]
}